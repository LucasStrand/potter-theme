# Tool file storage (see /tools/files). On Vercel the first two are injected when you
# link the integrations to the project; copy them here only for local development.

# Vercel Blob — create the store with *private* access.
BLOB_READ_WRITE_TOKEN=

# Neon Postgres (Vercel Marketplace). The tool_files table is created on first use.
DATABASE_URL=

# Password for the /tools/files browser.
FILES_PASSWORD=
